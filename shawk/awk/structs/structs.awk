	tabs_inc()
		emit(sprintf("delete %s", _db_nm))
		emit(                                   \
			sprintf(                            \
				"_%s(\"gen\", _%s(\"gen\")+1)", \
				make_fnm("set"),                \
				make_fnm("get")                 \
